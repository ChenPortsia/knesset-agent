# Copy to .env and fill in. .env is never committed.

# Which model answers, as provider:model. The provider prefix is required:
# google_genai (Gemini API key) or anthropic. Change this line to switch provider.
KNESSET_MODEL=google_genai:gemini-pro-latest
# KNESSET_MODEL=anthropic:claude-opus-5-5

# The model that grades answers in the test; leave empty to use KNESSET_MODEL
KNESSET_JUDGE_MODEL=
# A cheap grader keeps the test's cost down, e.g. anthropic:claude-haiku-5-5

# The key of the provider named above
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# Langfuse traces (from your Langfuse project's settings)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
