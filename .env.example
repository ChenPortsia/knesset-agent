# Copy to .env and fill in. .env is never committed.

# Which model answers, as provider:model. Change this line to switch provider.
KNESSET_MODEL=google_genai:<gemini model name>
# KNESSET_MODEL=anthropic:claude-opus-5-5

# The key of the provider named above
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# Langfuse traces (from your Langfuse project's settings)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
